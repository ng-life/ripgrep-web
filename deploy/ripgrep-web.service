[Unit]
Description=Ripgrep Web Log Search Service
After=network.target

[Service]
Type=simple
User=ripgrep-web
Group=ripgrep-web
Environment=LOG_BASE_DIR=/var/log
Environment=LISTEN_ADDR=0.0.0.0:5000
Environment=MAX_CONCURRENT_SEARCHES=4
Environment=RUST_LOG=ripgrep_web=info,tower_http=info
ExecStart=/usr/local/bin/ripgrep-web
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ripgrep-web

[Install]
WantedBy=multi-user.target
